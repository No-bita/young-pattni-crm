{
  "name": "springboard-v1",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "npm run build:web && wrangler dev",
    "build:web": "npm --prefix web run build",
    "test": "node --test --no-warnings=ExperimentalWarning tests/*.test.js",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "admin": "node scripts/admin.mjs"
  },
  "dependencies": {
    "hono": "4.12.27"
  },
  "devDependencies": {
    "wrangler": "4.42.0"
  }
}
